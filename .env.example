# Contact form email delivery via Resend (https://resend.com)
# Copy this file to .env.local for local development. Never commit real keys.

# API key from the Resend dashboard: https://resend.com/api-keys
# Required for the contact form to send. If it is missing, the form
# shows a friendly error instead of crashing.
RESEND_API_KEY=

# Inbox that receives contact form submissions.
CONTACT_TO_EMAIL=hello@thepostpartumot.com

# From address shown on the email. The domain (thepostpartumot.com) must be
# verified in Resend or sends will fail. See the README for the DNS step.
CONTACT_FROM_EMAIL=The Postpartum OT <website@thepostpartumot.com>
